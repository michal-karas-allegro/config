{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "github-copilot"
  ],
  "share": "disabled",
  "permission": {
    "read": {
      "*": "ask",
      "~/git/*": "allow"
    },
    "list": {
      "*": "ask",
      "~/git/*": "allow"
    },
    "grep": {
      "*": "ask",
      "~/git/*": "allow"
    },
    "glob": {
      "*": "ask",
      "~/git/*": "allow"
    },
    "*": "ask",
    "ls": "allow",
    "pwd": "allow",
    "cat": "allow",
    "echo": "allow",
    "head": "allow",
    "tail": "allow",
    "git status": "allow",
    "git diff": "allow",
    "git branch": "allow",
    "git show": "allow",
    "go vet": "allow"
  }
}
